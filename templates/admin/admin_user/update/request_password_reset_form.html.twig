{# Rendered outside of the administrator form, submitted by the button of the password field #}
{% set resource = hookable_metadata.context.resource %}
{% if hookable_metadata.context.form.plainPassword is not defined %}
    <form id="akawaka-request-password-reset" method="post" action="{{ path('akawaka_sylius_security_admin_admin_user_request_password_reset', {'id': resource.id}) }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('akawaka_request_admin_user_password_reset_' ~ resource.id) }}" />
    </form>
{% endif %}
