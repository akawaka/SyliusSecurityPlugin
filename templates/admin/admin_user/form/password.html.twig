{% set form = hookable_metadata.context.form %}

{% if form.plainPassword is defined %}
    {{ form_row(form.plainPassword) }}
{% else %}
    <div class="mb-3">
        <label class="form-label">{{ 'sylius.form.user.password.label'|trans }}</label>
        <p>{{ 'akawaka_sylius_security.admin_user.password_managed_by_owner'|trans }}</p>
        <button type="submit" form="akawaka-request-password-reset" class="btn" id="akawaka-request-password-reset-button">
            {{ ux_icon('tabler:mail', {class: 'icon'}) }}
            {{ 'akawaka_sylius_security.admin_user.request_password_reset'|trans }}
        </button>
    </div>
{% endif %}
