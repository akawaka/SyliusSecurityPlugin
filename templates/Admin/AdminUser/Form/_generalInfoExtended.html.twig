<div class="ui segment">
    {% if form.plainPassword is defined %}
        {{ form_row(form.plainPassword) }}
    {% else %}
        <div class="field">
            <label>{{ 'sylius.form.user.password.label'|trans }}</label>
            <p>{{ 'akawaka_sylius_security.admin_user.password_managed_by_owner'|trans }}</p>
            <button type="submit" form="akawaka-request-password-reset" class="ui labeled icon button" id="akawaka-request-password-reset-button">
                <i class="envelope icon"></i>
                {{ 'akawaka_sylius_security.admin_user.request_password_reset'|trans }}
            </button>
        </div>
    {% endif %}
    {{ form_row(form.enabled) }}
</div>
