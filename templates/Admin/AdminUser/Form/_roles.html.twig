{% if form.securityRoles is defined %}
    {% set rolesForm = form.securityRoles %}
    {% set checkboxes = {} %}
    {% for child in rolesForm %}
        {% set checkboxes = checkboxes|merge({(child.vars.value): child}) %}
    {% endfor %}

    <div class="ui segment">
        <h4 class="ui dividing header">{{ 'sylius.ui.roles'|trans }}</h4>

        {{ form_errors(rolesForm) }}

        {% for choice in rolesForm.vars.choices %}
            {% if choice.choices is not defined %}
                <div class="field">
                    <div class="ui toggle checkbox">
                        {{ form_widget(checkboxes[choice.value]) }}
                        {{ form_label(checkboxes[choice.value]) }}
                    </div>
                </div>
            {% endif %}
        {% endfor %}

        <table class="ui very basic compact unstackable table" id="akawaka-admin-roles">
            <thead>
                <tr>
                    <th></th>
                    <th class="center aligned collapsing">{{ 'akawaka_sylius_security.ui.role.read'|trans }}</th>
                    <th class="center aligned collapsing">{{ 'akawaka_sylius_security.ui.role.write'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for group in rolesForm.vars.choices %}
                    {% if group.choices is defined %}
                        <tr>
                            <td>{{ group.label|trans }}</td>
                            {% for choice in group.choices %}
                                {% set checkbox = checkboxes[choice.value] %}
                                <td class="center aligned">
                                    <div class="ui fitted checkbox">
                                        {{ form_widget(checkbox, {'attr': {'aria-label': group.label|trans ~ ' - ' ~ choice.label|trans}}) }}
                                        <label for="{{ checkbox.vars.id }}"></label>
                                    </div>
                                </td>
                            {% endfor %}
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>

        <div class="ui small info message">{{ 'akawaka_sylius_security.ui.write_implies_read'|trans }}</div>

        {% do rolesForm.setRendered %}
    </div>
{% endif %}
